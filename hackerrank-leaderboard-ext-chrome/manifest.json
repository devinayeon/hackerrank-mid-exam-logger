{
  "manifest_version": 3,
  "name": "HackerRank Leaderboard Scraper",
  "version": "1.0.0",
  "description": "Scrape leaderboard dan audit submission (kode, testcase, skor vs bobot) kontes HackerRank.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.hackerrank.com/*",
    "https://hackerrank.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.hackerrank.com/*",
        "https://hackerrank.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}